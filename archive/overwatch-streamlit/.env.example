# ── LLM ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Model to use for the ReAct agent (default: gpt-4o)
OVERWATCH_LLM_MODEL=gpt-4o

# ── SigNoz ───────────────────────────────────────────
# SigNoz base URL (cloud or self-hosted)
SIGNOZ_BASE_URL=http://localhost:3301
# SigNoz API access token
SIGNOZ_API_KEY=
# SigNoz MCP Server endpoint (if running separately)
SIGNOZ_MCP_URL=http://localhost:3001

# ── Demo App ─────────────────────────────────────────
# OTel collector endpoint for the demo Flask app
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
DEMO_APP_PORT=5050
