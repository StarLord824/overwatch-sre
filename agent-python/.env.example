# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
# Agent model. gpt-4.1 is a great drop-in (strong tool-calling). gpt-4o also fine.
# gpt-5.x / *-codex reasoning models work too — the code omits temperature for them.
LLM_MODEL=gpt-4.1
# Model the eval LLM-judge uses (defaults to gpt-4o-mini). Set to a model your key
# can access, e.g. gpt-4.1-mini or gpt-4.1.
EVAL_JUDGE_MODEL=gpt-4.1-mini

# ── SigNoz MCP server (stdio) ─────────────────────────────────────────────────
# The agent spawns the SigNoz MCP server over stdio and calls its tools directly.
SIGNOZ_URL=http://localhost:3301
SIGNOZ_API_KEY=your_signoz_api_key_here

# How to launch the MCP server: "docker" (default) or "binary"
SIGNOZ_MCP_MODE=docker
SIGNOZ_MCP_IMAGE=signoz/signoz-mcp-server:latest
# Only used when SIGNOZ_MCP_MODE=binary — absolute path to the downloaded server
SIGNOZ_MCP_BINARY=/absolute/path/to/signoz-mcp-server

# ── Report delivery (OpenSRE step 6 — optional, no-op if unset) ───────────────
# When the agent finishes an investigation it posts the RCA to whichever of these
# are configured. Set one for the demo.
# Slack: create an Incoming Webhook in your workspace and paste the URL.
SLACK_WEBHOOK_URL=
# Telegram: create a bot via @BotFather for the token, and use your chat/channel id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Infrastructure ────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://localhost:6379
